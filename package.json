{
  "name": "api-lucas-camargo-arquitetura",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "credentials:create": "node scripts/create-admin-credentials.mjs",
