  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
